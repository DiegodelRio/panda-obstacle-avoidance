<?xml version="1.0"?>
<sdf version="1.9">
  <world name="panda_world">

    <!-- Physics runs at 1 kHz. The real_time_factor of 1 keeps the simulation
         at wall-clock speed, so a 5 s trajectory takes 5 s to watch. -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Systems every world needs: physics, commands from the GUI,
         and the state updates that the GUI draws. -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- A single sun so the arm is lit from above. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Flat ground at z = 0. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- The Panda, with its base at the world origin. run_sim.sh tells Gazebo
         where to find model://panda. -->
    <include>
      <uri>model://panda</uri>
      <name>panda</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- The obstacle: a fixed red ball, 8 cm in radius. static means gravity and
         contact cannot move it, so it stays in the air and blocks the arm.
         It sits above the A-to-B path, so it blocks the arm's links and not the
         end-effector. The collision block is what makes it physically solid. -->
    <model name="obstacle">
      <static>true</static>
      <pose>0.26 0.12 0.66 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <sphere><radius>0.08</radius></sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere><radius>0.08</radius></sphere>
          </geometry>
          <material>
            <ambient>0.75 0.18 0.08 1</ambient>
            <diffuse>0.75 0.18 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Point A (green) and point B (magenta) of the end-effector path.
         They have no collision block, so nothing can touch them. -->
    <model name="point_A">
      <static>true</static>
      <pose>0.35 -0.15 0.25 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere><radius>0.012</radius></sphere>
          </geometry>
          <material>
            <ambient>0.1 0.7 0.2 1</ambient>
            <diffuse>0.1 0.7 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="point_B">
      <static>true</static>
      <pose>0.60 0.15 0.35 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere><radius>0.012</radius></sphere>
          </geometry>
          <material>
            <ambient>0.85 0.1 0.65 1</ambient>
            <diffuse>0.85 0.1 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
