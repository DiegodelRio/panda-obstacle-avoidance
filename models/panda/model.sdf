    <!-- ===== Arm joints (these 7 are the ones you control) ===== -->

    <joint name="panda_joint1" type="revolute">
      <pose relative_to="panda_link0">0 0 0.333 0 0 0</pose>
      <parent>panda_link0</parent>
      <child>panda_link1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-2.8973</lower>
          <upper>2.8973</upper>
          <effort>87.0</effort>
          <velocity>2.175</velocity>
        </limit>
      </axis>
    </joint>

    <joint name="panda_joint2" type="revolute">
      <pose relative_to="panda_link1">0 0 0 -1.5707963267948966 0 0</pose>
      <parent>panda_link1</parent>
      <child>panda_link2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.7628</lower>
          <upper>1.7628</upper>
          <effort>87.0</effort>
          <velocity>2.175</velocity>
        </limit>
      </axis>
    </joint>

    <joint name="panda_joint3" type="revolute">
      <pose relative_to="panda_link2">0 -0.316 0 1.5707963267948966 0 0</pose>
      <parent>panda_link2</parent>
      <child>panda_link3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-2.8973</lower>
          <upper>2.8973</upper>
          <effort>87.0</effort>
          <velocity>2.175</velocity>
        </limit>
      </axis>
    </joint>

    <!-- Real upper limit is -0.0698 rad. It is opened to 0 here because Gazebo
         starts every joint at q = 0. Your controller must still use -0.0698. -->
    <joint name="panda_joint4" type="revolute">
      <pose relative_to="panda_link3">0.0825 0 0 1.5707963267948966 0 0</pose>
      <parent>panda_link3</parent>
      <child>panda_link4</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.0718</lower>
          <upper>0.0</upper>
          <effort>87.0</effort>
          <velocity>2.175</velocity>
        </limit>
      </axis>
    </joint>

    <joint name="panda_joint5" type="revolute">
