          <upper>3.7525</upper>
          <effort>12.0</effort>
          <velocity>2.61</velocity>
        </limit>
      </axis>
    </joint>

    <joint name="panda_joint7" type="revolute">
      <pose relative_to="panda_link6">0.088 0 0 1.5707963267948966 0 0</pose>
      <parent>panda_link6</parent>
      <child>panda_link7</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-2.8973</lower>
          <upper>2.8973</upper>
          <effort>12.0</effort>
          <velocity>2.61</velocity>
        </limit>
      </axis>
    </joint>

    <!-- ===== Fixed joints ===== -->

    <!-- Combines the URDF's joint8 (0.107 m along z) and hand joint (-45 deg yaw). -->
    <joint name="panda_hand_mount" type="fixed">
      <pose relative_to="panda_link7">0 0 0.107 0 0 -0.7853981633974483</pose>
      <parent>panda_link7</parent>
      <child>panda_hand</child>
    </joint>

    <!-- The fingers do not move in this project, so they are fixed closed. -->
    <joint name="panda_leftfinger_mount" type="fixed">
      <pose relative_to="panda_hand">0 0 0.0584 0 0 0</pose>
      <parent>panda_hand</parent>
      <child>panda_leftfinger</child>
    </joint>

    <joint name="panda_rightfinger_mount" type="fixed">
      <pose relative_to="panda_hand">0 0 0.0584 0 0 0</pose>
      <parent>panda_hand</parent>
      <child>panda_rightfinger</child>
    </joint>

    <!-- ===== Connections to Python =====
         One position controller per joint. Publish a gz.msgs.Double to
         /panda/jointN/cmd_pos to set that joint's target angle in radians.
         use_velocity_commands skips Gazebo's PID, so the joint goes straight
         to the target at up to cmd_max rad/s and there are no gains to tune.
         initial_position is the pose the arm moves to at startup. It puts the
         end-effector at point A with the hand pointing straight down. -->

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>panda_joint1</joint_name>
      <topic>/panda/joint1/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>1.5</cmd_max>
      <cmd_min>-1.5</cmd_min>
      <initial_position>-0.303918</initial_position>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>panda_joint2</joint_name>
      <topic>/panda/joint2/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>1.5</cmd_max>
      <cmd_min>-1.5</cmd_min>
      <initial_position>-0.404112</initial_position>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>panda_joint3</joint_name>
      <topic>/panda/joint3/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>1.5</cmd_max>
      <cmd_min>-1.5</cmd_min>
      <initial_position>-0.104118</initial_position>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>panda_joint4</joint_name>
      <topic>/panda/joint4/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>1.5</cmd_max>
      <cmd_min>-1.5</cmd_min>
      <initial_position>-2.705802</initial_position>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>panda_joint5</joint_name>
      <topic>/panda/joint5/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>1.5</cmd_max>
      <cmd_min>-1.5</cmd_min>
      <initial_position>-0.054971</initial_position>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>panda_joint6</joint_name>
      <topic>/panda/joint6/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>1.5</cmd_max>
      <cmd_min>-1.5</cmd_min>
