<?xml version="1.0"?>
<sdf version="1.9">
  <model name="panda">

    <!-- Franka Emika Panda: 7 revolute joints plus a hand with its fingers fixed.
         See NOTICE.md for the source of this model and what was changed. -->

    <!-- Bolt the base to the world so the arm cannot fall over. -->
    <joint name="world_to_base" type="fixed">
      <parent>world</parent>
      <child>panda_link0</child>
    </joint>

    <!-- Tool centre point: use this frame as the end-effector in your FK.
         It sits 0.1034 m along the hand's z axis. -->
    <frame name="panda_hand_tcp" attached_to="panda_hand">
      <pose relative_to="panda_hand">0 0 0.1034 0 0 0</pose>
    </frame>

    <!-- ===== Links ===== -->

    <link name="panda_link0">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>-0.041018 -0.00014 0.049974 0 0 0</pose>
        <mass>0.629769</mass>
        <inertia>
          <ixx>0.00315</ixx>
          <ixy>8.2904e-07</ixy>
          <ixz>0.00015</ixz>
          <iyy>0.00388</iyy>
          <iyz>8.2299e-06</iyz>
          <izz>0.004285</izz>
        </inertia>
      </inertial>
      <visual name="visual_0">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://panda/meshes/visual/link0.dae</uri></mesh>
        </geometry>
      </visual>
      <collision name="collision_0">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://panda/meshes/collision/link0.stl</uri></mesh>
        </geometry>
      </collision>
    </link>

